{
  "id": "op-delegation",
  "name": "Observer Protocol delegation verification",
  "version": 1,
  "created_at": "REPLACE-ISO-8601-TIMESTAMP",
  "rules": [
    {
      "type": "allowed_chains",
      "chain_ids": ["eip155:1"]
    },
    {
      "type": "expires_at",
      "timestamp": "REPLACE-WITH-CREDENTIAL-validUntil"
    }
  ],
  "executable": "/ABSOLUTE/PATH/TO/.ows/plugins/policies/ows-op-verify.cjs",
  "action": "deny",
  "config": {
    "credentialPath": "/ABSOLUTE/PATH/TO/delegation-credential.json",
    "issuerDid": "did:web:observerprotocol.org",
    "schemaAllowlist": ["https://observerprotocol.org/schemas/delegation/v2.1.json"],
    "revocation": {
      "maxStalenessHours": 24,
      "onUnreachable": "cache-then-deny",
      "fetchTimeoutMs": 1500
    },
    "didCache": { "maxStalenessHours": 24 },
    "cacheDir": "~/.cache/ows-op-policy",
    "auditLog": "~/.cache/ows-op-policy/decisions.jsonl",
    "allowContractCalls": false
  }
}
