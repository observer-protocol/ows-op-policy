{
  "name": "@observer-protocol/ows-op-verify",
  "version": "0.3.0",
  "description": "Observer Protocol delegation-credential verifier for the Open Wallet Standard policy engine. Pre-signing enforcement of signed agent mandates as an OWS custom-executable policy.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ows-op-verify": "dist/ows-op-verify.cjs"
  },
  "files": [
    "dist/ows-op-verify.cjs",
    "installer/install.mjs",
    "policy/op-delegation.template.json",
    "docs/SCOPE.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node18 --format=cjs --banner:js='#!/usr/bin/env node' --outfile=dist/ows-op-verify.cjs && chmod +x dist/ows-op-verify.cjs",
    "typecheck": "tsc --noEmit",
    "fixtures": "node test/fixtures/gen.mjs",
    "test": "npm run build && npm run fixtures && node test/run.mjs",
    "livefire": "node harness/live-fire.mjs",
    "prepublishOnly": "bash scripts/refuse-dirty-publish.sh && npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/observer-protocol/ows-op-policy.git"
  },
  "homepage": "https://github.com/observer-protocol/ows-op-policy#readme",
  "bugs": {
    "url": "https://github.com/observer-protocol/ows-op-policy/issues"
  },
  "keywords": [
    "open-wallet-standard",
    "ows",
    "observer-protocol",
    "agent-wallet",
    "policy-engine",
    "verifiable-credentials",
    "did",
    "delegation",
    "eddsa-jcs-2022"
  ],
  "devDependencies": {
    "@types/node": "^25.9.2",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "@observer-protocol/policy-engine": ">=0.4.0 <1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
